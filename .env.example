# Supabase project URL from the Supabase Connect/API panel.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Preferred current backend secret key. Never expose this to the browser.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Optional compatibility variable for older Supabase projects.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# 24-hour session lifetime by default.
SESSION_TTL_HOURS=24

# Automatically set by production deployments, but can be overridden.
COOKIE_SECURE=false

# Set by your hosting platform. Local default is 5173.
PORT=5173
